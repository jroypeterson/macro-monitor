# Macro Monitor — environment variables
# Copy to .env and fill in. .env is gitignored.

# === REQUIRED for Phase 1a (CPI end-to-end) ===

# FRED API key — register at https://fredaccount.stlouisfed.org/apikeys (free, instant)
FRED_API_KEY=

# ClaudeFin Slack bot token (xoxb-...) — same bot as #status-reports / #earnings.
# Copy from earnings_agent/.env or sigma-alert env. Bot must be invited to #macro.
SLACK_BOT_TOKEN=

# Slack channel ID for #macro. Looked up via Slack API once bot is in the channel,
# or grab from Slack URL: https://<workspace>.slack.com/archives/<CHANNEL_ID>
SLACK_MACRO_CHANNEL_ID=

# Shared #status-reports webhook (per HEALTH_REPORTING.md §4.8).
# Copy from earnings_agent/.env or any sibling project.
SLACK_WEBHOOK_STATUS_REPORTS=

# === OPTIONAL (fallbacks; not needed for Phase 1a) ===

# BLS API key — only used if FRED ingest lag is observed for a specific Tier A family.
# Register at https://data.bls.gov/registrationEngine/ (free).
BLS_API_KEY=

# BEA API key — Phase 2 monthly health-services PCE via Table 2.4.5U.
# Register at https://apps.bea.gov/API/signup/ (free).
BEA_API_KEY=

# === Phase 1f (Google Calendar — not blocking earlier phases) ===

# Google Calendar ID for the dedicated "Macro Calendar".
# IMPORTANT: this calendar lives in floridabusinessman@gmail.com (BUSINESS account),
# NOT jroypeterson@gmail.com (personal).
#
# Auth is via the SHARED earnings-agent SERVICE ACCOUNT — NOT a user OAuth token.
# Share the calendar with earnings-agent@earnings-agent-486621.iam.gserviceaccount.com
# at "Make changes to events", then point GOOGLE_CREDENTIALS_PATH at the same
# credentials.json earnings_agent uses. (No .google_calendar_token.json needed.)
GOOGLE_CALENDAR_ID=
GOOGLE_CREDENTIALS_PATH=

# EDGAR_IDENTITY (shared per memory — used if we ever pull from EDGAR for FOMC PDFs)
EDGAR_IDENTITY=Jason Peterson jroypeterson@gmail.com

# === Phase 2 (International / "Global macro") ===
# Japan e-Stat application ID — enables Japan CPI/GDP (other regions need no key).
# Register at https://www.e-stat.go.jp/en → log in → My Page → "Issue Application
# ID" (enter http://localhost/ as the URL). Yields a ~40-char string.
# Eurozone (Eurostat/ECB), UK (ONS/BoE) and China (OECD) are keyless.
ESTAT_APP_ID=
